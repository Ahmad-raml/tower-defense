{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "CMake Build",
      "type": "shell",
      "command": "cmake --build build --config Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake Configure"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./build/tower_defense",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake Build"
      ]
    }
  ]
}